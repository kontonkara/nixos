 (* Set the toplevel role for an xdg_surface. *)
-let init_toplevel t ~x11 ~xdg_surface ~info ~paired window =
+let init_toplevel t ~x11 ~host_surface ~xdg_surface ~info ~paired window =
+  let pending_configure = ref None in
+  let configure_scheduled = ref false in
+  let schedule_configure () =
+    if not !configure_scheduled then (
+      configure_scheduled := true;
+      Fiber.fork ~sw:t.sw (fun () ->
+          Eio_unix.sleep 0.016;
+          configure_scheduled := false;
+          match !pending_configure with
+          | None -> ()
+          | Some (width, height) ->
+            pending_configure := None;
+            let (width, height) = scale_to_client t (width, height) in
+            (paired:paired).geometry <- { paired.geometry with width; height };
+            let (host_width, host_height) = scale_to_host t (width, height) in
+            Xdg_surface.set_window_geometry xdg_surface
+              ~x:0l ~y:0l
+              ~width:(Int32.of_int host_width)
+              ~height:(Int32.of_int host_height);
+            H.Wp_viewport.set_destination paired.viewport
+              ~width:(Int32.of_int host_width)
+              ~height:(Int32.of_int host_height);
+            Wl_surface.commit host_surface;
+            X11.Window.configure x11 window ~width ~height ~border_width:0;
+            X11.Display.sync x11
+        )
+    )
+  in
