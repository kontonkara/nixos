--- a/src/platform/virtualhid_input.cpp
+++ b/src/platform/virtualhid_input.cpp
@@ -18,6 +18,13 @@
 #include <string_view>
 #include <utility>
 
+#ifdef __linux__
+  #include <cstdlib>
+  #include <string>
+  #include <sys/wait.h>
+  #include <unistd.h>
+#endif
+
 // local includes
 #include "src/config.h"
 #include "src/logging.h"
@@ -842,7 +849,52 @@
     }
   }
 
+#ifdef __linux__
+  /**
+   * Types text through the Wayland virtual-keyboard protocol.
+   *
+   * wtype uploads a keymap holding exactly the keysyms it needs, so the
+   * compositor delivers ordinary key events for any codepoint. Unlike the
+   * ISO 14755 sequence libvirtualhid types, this reaches every client, not
+   * just the ones carrying an input method that implements it.
+   */
+  bool unicode_via_wtype(const std::string &text) {
+    if (!std::getenv("WAYLAND_DISPLAY")) {
+      return false;
+    }
+
+    pid_t pid = fork();
+    if (pid < 0) {
+      BOOST_LOG(warning) << "Unicode, unable to fork for wtype"sv;
+      return false;
+    }
+
+    if (pid == 0) {
+      execl("@wtype@", "wtype", "--", text.c_str(), nullptr);
+      _exit(127);
+    }
+
+    int status = 0;
+    if (waitpid(pid, &status, 0) < 0) {
+      return false;
+    }
+
+    if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
+      return true;
+    }
+
+    BOOST_LOG(warning) << "Unicode, wtype failed, falling back to ISO 14755"sv;
+    return false;
+  }
+#endif
+
   void unicode(input_context_t &context, const char *utf8, int size) {
+#ifdef __linux__
+    if (utf8 && size > 0 && unicode_via_wtype(std::string {utf8, static_cast<std::size_t>(size)})) {
+      return;
+    }
+#endif
+
     if (context.keyboard && utf8 && size > 0) {
       log_failure("submit libvirtualhid text input"sv, context.keyboard->type_text({.text = std::string {utf8, static_cast<std::size_t>(size)}}));
     }
