--- a/kernel-open/nvidia/nv-pci.c
+++ b/kernel-open/nvidia/nv-pci.c
@@ -2692,7 +2692,12 @@
      * sysfs or hotplug is synchronous, so the kthread overhead is not
      * worthwhile.
      */
-    if (!smp_load_acquire(&nv_pci_driver_registration_in_progress))
+    /*
+     * Linux 7.3 runs kthreads in an empty nullfs root, so the probe body's
+     * filp_open() of /sys/bus/pci/devices/.../config fails there and runtime
+     * D3 is reported as not supported. Probe in the caller's context.
+     */
+    if (NV_TRUE || !smp_load_acquire(&nv_pci_driver_registration_in_progress))
     {
         return nv_pci_probe_body(pci_dev, id_table);
     }
@@ -3499,7 +3504,7 @@
 #if defined(CONFIG_PM)
     .driver.pm = &nv_pm_ops,
 #endif
-#if NV_PCI_ASYNC_PROBE_SUPPORTED
+#if 0 /* async probe also runs in a kthread; see nv_pci_probe() */
     .driver.probe_type = PROBE_PREFER_ASYNCHRONOUS,
 #else
     .driver.probe_type = PROBE_FORCE_SYNCHRONOUS,
