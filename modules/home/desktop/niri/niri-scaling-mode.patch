     }
 
+    // Callers commit this before the DrmCompositor applies a new mode, which matters because
+    // drivers may pick the scanout timings based on the scaling mode during a modeset (e.g.
+    // amdgpu keeps sending the native timings to the panel and scales in the display engine).
+    let scaling_mode = config.and_then(|c| Some((&c.name, c.scaling_mode?)));
+    if let Some((name, scaling_mode)) = scaling_mode {
+        if let Err(err) = props.set_scaling_mode(scaling_mode) {
+            warn!("output {name:?}: failed to set `scaling mode` property: {err}");
+        }
+    }
+
     if reset_hdr {
         if let Err(err) = props.reset_hdr() {
             debug!("failed to set HDR properties: {err}");
@@ -3420,6 +3471,19 @@ fn is_vrr_capable(device: &DrmDevice, connector: connector::Handle) -> Option<bo
     info.value_type().convert_value(value).as_boolean()
 }
 
+/// Returns the name of the value of the "scaling mode" connector property.
+///
+/// These names are the kernel UAPI (drm_scaling_mode_enum_list), but drivers may expose only a
+/// subset of them.
+fn drm_scaling_mode_name(scaling_mode: ScalingMode) -> &'static std::ffi::CStr {
+    match scaling_mode {
+        ScalingMode::None => c"None",
+        ScalingMode::Full => c"Full",
+        ScalingMode::Center => c"Center",
+        ScalingMode::FullAspect => c"Full aspect",
+    }
+}
