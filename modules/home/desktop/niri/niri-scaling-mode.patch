+    fn scaling_mode(&self) -> anyhow::Result<ScalingMode> {
+        let (info, value) = self.find(c"scaling mode")?;
+        let value_type = info.value_type();
+        let property::Value::Enum(Some(value)) = value_type.convert_value(*value) else {
+            bail!("wrong property type or value")
+        };
+
+        let name = value.name();
+        let modes = [
+            ScalingMode::None,
+            ScalingMode::Full,
+            ScalingMode::Center,
+            ScalingMode::FullAspect,
+        ];
+        modes
+            .into_iter()
+            .find(|mode| drm_scaling_mode_name(*mode) == name)
+            .with_context(|| format!("unknown scaling mode: {name:?}"))
+    }
+
+    fn set_scaling_mode(&mut self, scaling_mode: ScalingMode) -> anyhow::Result<()> {
+        let (info, value) = self.find(c"scaling mode")?;
+        let property::ValueType::Enum(enum_values) = info.value_type() else {
+            bail!("wrong property type")
+        };
+
+        let name = drm_scaling_mode_name(scaling_mode);
+        let (_, values) = enum_values.values();
+        let Some(target) = values.iter().find(|v| v.name() == name) else {
+            let supported: Vec<_> = values.iter().map(|v| v.name()).collect();
+            bail!("{name:?} is not supported by the connector, supported: {supported:?}");
+        };
+
+        let target = target.value();
+        if *value != target {
+            self.requests
+                .add_raw_property(self.connector.into(), info.handle(), target);
+            self.has_change = true;
+        }
+
+        Ok(())
+    }
+
     fn commit(&mut self) -> anyhow::Result<()> {
         if self.has_change {
             self.device.atomic_commit(
@@ -3395,15 +3436,25 @@ impl<'a> ConnectorProperties<'a> {
 
