+/// Output scaling mode.
+///
+/// Controls how the display hardware scales a mode whose resolution doesn't match the native
+/// resolution of the display (the "scaling mode" DRM connector property).
+#[derive(Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq)]
+#[cfg_attr(feature = "clap", derive(clap::ValueEnum))]
+#[cfg_attr(feature = "json-schema", derive(schemars::JsonSchema))]
+pub enum ScalingMode {
+    /// No scaling requested; the driver decides.
+    None,
+    /// Stretch to fill the whole display, ignoring the aspect ratio.
+    Full,
+    /// Keep the original size and center, with black borders.
+    Center,
+    /// Scale as much as possible while preserving the aspect ratio, with black bars.
+    FullAspect,
+}
+
 /// Toplevel window.
 #[derive(Serialize, Deserialize, Debug, Clone)]
 #[cfg_attr(feature = "json-schema", derive(schemars::JsonSchema))]
@@ -1933,6 +1959,20 @@ impl FromStr for MaxBpc {
     }
 }
 
+impl FromStr for ScalingMode {
+    type Err = &'static str;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "none" => Ok(Self::None),
+            "full" => Ok(Self::Full),
+            "center" => Ok(Self::Center),
+            "full-aspect" => Ok(Self::FullAspect),
+            _ => Err(r#"invalid scaling mode, can be "none", "full", "center" or "full-aspect""#),
+        }
+    }
+}
+
 impl FromStr for Layer {
