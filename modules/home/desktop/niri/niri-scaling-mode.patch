     reset_hdr: bool,
 ) {
-    if let Some(max_bpc) = max_bpc {
+    if let Some(max_bpc) = config.and_then(|c| c.max_bpc) {
         if let Err(err) = props.set_max_bpc(max_bpc) {
             debug!("failed to set `max bpc` property: {err}");
